# ==========================================
# Backend DataSource Configuration
# ==========================================
# Opción 1 - Desarrollo Local (H2 en memoria - Por defecto):
SPRING_DATASOURCE_URL=jdbc:h2:mem:mercadolibro;DB_CLOSE_DELAY=-1;MODE=PostgreSQL;INIT=RUNSCRIPT FROM 'classpath:h2-enums.sql'
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Opción 2 - Supabase Cloud (Para la entrega final):
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.<PROJECT_REF>
# SPRING_DATASOURCE_PASSWORD=<PASSWORD>

# ==========================================
# Integraciones
# ==========================================
GOOGLE_BOOKS_API_KEY=tu_api_key_aqui

# ==========================================
# Seguridad
# ==========================================
# Clave para firmar los JWT (mínimo 32 caracteres). En Render configurarla como variable de entorno.
# Si no se define, el backend genera una aleatoria en cada arranque.
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria_de_32_o_mas_caracteres
