    {
      "name": "03 - Publicaciones",
      "item": [
        {
          "name": "Publicar libro válido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"{{publicationIsbn}}\",\n  \"estadoFisico\": \"NUEVO\",\n  \"valorPuntosSolicitado\": 100,\n  \"comentario\": \"Publicación creada por la suite de Postman\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/publicaciones/publicar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Publicar responde HTTP 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('PublicacionResponseDTO contiene el contrato actual', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.publicacionId.isbn).to.eql(pm.collectionVariables.get('publicationIsbn'));",
                  "  pm.expect(body.publicacionId.emailPropietario).to.eql(pm.collectionVariables.get('testEmail'));",
                  "  pm.expect(body.publicacionId.horaPublicacion).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.estadoFisico).to.eql('NUEVO');",
                  "  pm.expect(body.valorPuntosSolicitado).to.eql(100);",
                  "  pm.expect(body).to.have.property('valorReferenciaCalculado');",
                  "  pm.expect(body).to.have.property('colorSemaforo');",
                  "  pm.collectionVariables.set('publicationOwner', body.publicacionId.emailPropietario);",
                  "  pm.collectionVariables.set('publicationTime', body.publicacionId.horaPublicacion);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Publicar inválido - campos obligatorios",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"\",\n  \"estadoFisico\": null,\n  \"valorPuntosSolicitado\": 0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/publicaciones/publicar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechaza PublicacionRequestDTO con HTTP 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Devuelve ValidationError', function () { pm.expect(pm.response.json().error).to.eql('ValidationError'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Publicar sin JWT",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"9789875666467\",\n  \"estadoFisico\": \"NUEVO\",\n  \"valorPuntosSolicitado\": 100\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/publicaciones/publicar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El endpoint protegido rechaza la solicitud sin JWT', function () { pm.expect([401, 403]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar publicaciones disponibles",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/publicaciones/disponibles"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Listado público responde HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('El listado es una lista', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar mis publicaciones",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/publicaciones/mis-publicaciones"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mis publicaciones responde HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Incluye la publicación creada', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('array');",
                  "  pm.expect(body.some(function (item) { return item.publicacionId && item.publicacionId.horaPublicacion === pm.collectionVariables.get('publicationTime'); })).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle de publicación",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/publicaciones/detalle?isbn={{publicationIsbn}}&emailPropietario={{publicationOwner}}&horaPublicacion={{publicationTime}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Detalle responde HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve el mismo identificador compuesto', function () { pm.expect(pm.response.json().publicacionId.horaPublicacion).to.eql(pm.collectionVariables.get('publicationTime')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar publicación propia",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"{{publicationIsbn}}\",\n  \"estadoFisico\": \"COMO_NUEVO\",\n  \"valorPuntosSolicitado\": 90,\n  \"comentario\": \"Actualizada por la suite\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/publicaciones/editar?isbn={{publicationIsbn}}&emailPropietario={{publicationOwner}}&horaPublicacion={{publicationTime}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Editar responde HTTP 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar publicación propia",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/publicaciones/eliminar?isbn={{publicationIsbn}}&emailPropietario={{publicationOwner}}&horaPublicacion={{publicationTime}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Eliminar responde HTTP 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    },
