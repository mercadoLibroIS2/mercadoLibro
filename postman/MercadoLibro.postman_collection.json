    {
      "name": "00 - Disponibilidad",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/test/ping"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Confirma disponibilidad', function () { pm.expect(pm.response.json()).to.deep.include({ status: 'ok', message: 'pong' }); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Autenticación",
      "item": [
        {
          "name": "Registro válido - crea usuario QA",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{testUsername}}\",\n  \"email\": \"{{testEmail}}\",\n  \"contrasenia\": \"{{testPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/registro"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString();",
                  "pm.collectionVariables.set('testUsername', 'qa_' + suffix);",
                  "pm.collectionVariables.set('testEmail', 'qa_' + suffix + '@example.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registro responde HTTP 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('AuthResponseDTO tiene identidad, rol y puntos iniciales', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.username).to.eql(pm.collectionVariables.get('testUsername'));",
                  "  pm.expect(body.email).to.eql(pm.collectionVariables.get('testEmail'));",
                  "  pm.expect(body.rol).to.eql('USUARIO');",
                  "  pm.expect(body.puntos).to.be.a('number');",
                  "  pm.collectionVariables.set('userId', body.id);",
                  "  pm.collectionVariables.set('token', body.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Registro inválido - validación de UsuarioRequestDTO",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"ab\",\n  \"email\": \"correo-invalido\",\n  \"contrasenia\": \"123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/registro"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechaza el DTO con HTTP 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Devuelve ValidationError', function () { pm.expect(pm.response.json().error).to.eql('ValidationError'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Registro duplicado - mismo email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{testUsername}}_duplicado\",\n  \"email\": \"{{testEmail}}\",\n  \"contrasenia\": \"{{testPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/registro"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechaza el email duplicado con HTTP 409', function () { pm.response.to.have.status(409); });",
                  "pm.test('Devuelve UsuarioYaExiste', function () { pm.expect(pm.response.json().error).to.eql('UsuarioYaExiste'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login válido con nombre",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreOEmail\": \"{{testUsername}}\",\n  \"contrasenia\": \"{{testPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login responde HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve AuthResponseDTO del usuario QA', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.eql(pm.collectionVariables.get('userId'));",
                  "  pm.expect(body.username).to.eql(pm.collectionVariables.get('testUsername'));",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('token', body.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login válido con email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreOEmail\": \"{{testEmail}}\",\n  \"contrasenia\": \"{{testPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login por email responde HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve el email del usuario QA', function () { pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('testEmail')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login inválido - contraseña incorrecta",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreOEmail\": \"{{testUsername}}\",\n  \"contrasenia\": \"Incorrecta2026!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Credenciales incorrectas responden HTTP 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('La respuesta no contiene token', function () { pm.expect(pm.response.text()).not.to.include('\"token\"'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Refrescar token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/auth/refrescar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh responde HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve un token válido y conserva el usuario', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.id).to.eql(pm.collectionVariables.get('userId'));",
                  "  pm.collectionVariables.set('token', body.token);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Perfil, puntos y notificaciones",
      "item": [
        {
          "name": "Consultar perfil propio",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/usuario/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Perfil responde HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Perfil contiene el contrato vigente', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.eql(pm.collectionVariables.get('userId'));",
                  "  pm.expect(body.nombre).to.eql(pm.collectionVariables.get('testUsername'));",
                  "  pm.expect(body.email).to.eql(pm.collectionVariables.get('testEmail'));",
                  "  ['saldoTotal', 'saldoReservado', 'saldoDisponible', 'reputacionPromedio'].forEach(function (field) { pm.expect(body).to.have.property(field); });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar saldo de puntos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/movimientoPuntos/saldo"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Saldo responde HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Saldo expone los tres saldos', function () { pm.expect(pm.response.json()).to.have.all.keys('saldoTotal', 'saldoReservado', 'saldoDisponible'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar historial de puntos",
          "request": {
